<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zupu.zupu.mapper.MessageBoardMapper">
    
    <resultMap id="BaseResultMap" type="com.zupu.zupu.entity.MessageBoard">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="category" property="category"/>
        <result column="attachment" property="attachment"/>
        <result column="attachment_name" property="attachmentName"/>
        <result column="author_id" property="authorId"/>
        <result column="author_name" property="authorName"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="status" property="status"/>
    </resultMap>
    
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM message_board ORDER BY create_time DESC
    </select>
    
    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM message_board WHERE id = #{id}
    </select>
    
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO message_board (title, content, category, attachment, attachment_name, 
                                  author_id, author_name, create_time, status)
        VALUES (#{title}, #{content}, #{category}, #{attachment}, #{attachmentName},
                #{authorId}, #{authorName}, NOW(), 1)
    </insert>
    
    <update id="update">
        UPDATE message_board 
        SET title = #{title},
            content = #{content},
            category = #{category},
            attachment = #{attachment},
            attachment_name = #{attachmentName},
            update_time = NOW()
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM message_board WHERE id = #{id}
    </delete>
    
    <select id="count" resultType="int">
        SELECT COUNT(*) FROM message_board
    </select>
    
    <select id="selectByPage" resultMap="BaseResultMap">
        SELECT * FROM message_board ORDER BY create_time DESC LIMIT #{offset}, #{limit}
    </select>
</mapper>
