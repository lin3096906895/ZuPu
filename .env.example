# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）
MYSQL_ROOT_PASSWORD=change-me
DEEPSEEK_API_KEY=your-deepseek-api-key

# 百度地图浏览器端 AK（前端构建期注入 index.html）
BAIDU_MAP_AK=your-baidu-map-browser-ak

# JWT 签名密钥，生产环境务必换成随机值（>= 32 字节）
JWT_SECRET=please-change-me-to-a-random-secret-at-least-32-bytes

# 允许跨域访问后端的前端来源，逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 是否启用内置演示账号（admin / demo，密码见 README）。
# 部署到公网前请改为 false，启动时会自动禁用仍使用默认密码的演示账号
DEMO_ACCOUNTS_ENABLED=true

# 注入 AI system prompt 的家族成员上限
AI_MAX_PROMPT_MEMBERS=200
